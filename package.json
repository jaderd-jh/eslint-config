{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@jhqn/eslint-config",
  "type": "module",
  "version": "1.0.1",
  "packageManager": "pnpm@12.3.4",
  "description": "jhqn's ESLint config",
  "author": "jade-gjz",
  "license": "MIT",
  "homepage": "https://github.com/jaderd-jh/eslint-config",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaderd-jh/eslint-config"
  },
  "bugs": {
    "url": "https://github.com/jaderd-jh/eslint-config/issues"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": "./bin/index.mjs",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "pnpm run typegen && tsdown --clean --dts",
    "stub": "tsdown",
    "dev": "npx @eslint/config-inspector --config eslint.config.ts",
    "build:inspector": "pnpm build && npx @eslint/config-inspector build",
    "watch": "tsdown --watch",
    "lint": "eslint",
    "fix:lint": "eslint --fix",
    "typegen": "tsx scripts/typegen.ts",
    "prepack": "pnpm build",
    "updeps": "pnpm up -i --latest -r",
    "release": "bumpp",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@unocss/eslint-plugin": "^66.10.0",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^10.0.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-erasable-syntax-only": "^0.7.1",
    "eslint-plugin-jsx-a11y": ">=6.10.2",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-solid": "^0.17.0",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-vue": "^10.11.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "eslint-processor-vue-blocks": "^2.0.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-slidev": "^1.0.5",
    "svelte-eslint-parser": "^1.8.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "peerDependenciesMeta": {
    "@eslint-react/eslint-plugin": {
      "optional": true
    },
    "@unocss/eslint-plugin": {
      "optional": true
    },
    "astro-eslint-parser": {
      "optional": true
    },
    "eslint-plugin-astro": {
      "optional": true
    },
    "eslint-plugin-erasable-syntax-only": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "eslint-plugin-react-refresh": {
      "optional": true
    },
    "eslint-plugin-solid": {
      "optional": true
    },
    "eslint-plugin-svelte": {
      "optional": true
    },
    "eslint-plugin-vue": {
      "optional": true
    },
    "eslint-plugin-vuejs-accessibility": {
      "optional": true
    },
    "eslint-processor-vue-blocks": {
      "optional": true
    },
    "prettier-plugin-astro": {
      "optional": true
    },
    "prettier-plugin-slidev": {
      "optional": true
    },
    "svelte-eslint-parser": {
      "optional": true
    },
    "vue-eslint-parser": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/install-pkg": "^2.0.1",
    "@clack/prompts": "^1.7.0",
    "@e18e/eslint-plugin": "^0.8.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/markdown": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "ansis": "^4.3.1",
    "cac": "^7.0.0",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-flat-config-utils": "^3.2.0",
    "eslint-merge-processors": "^2.0.0",
    "eslint-plugin-antfu": "^3.2.3",
    "eslint-plugin-command": "^4.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.3.6",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-toml": "^1.5.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-yml": "^3.8.1",
    "globals": "^17.12.0",
    "local-pkg": "^1.2.1",
    "parse-gitignore": "^2.0.0",
    "toml-eslint-parser": "^1.0.3",
    "yaml-eslint-parser": "^2.1.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.8",
    "@eslint/config-inspector": "^3.4.0",
    "@jhqn/eslint-config": "workspace:*",
    "@stylistic/eslint-plugin-migrate": "^4.4.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^24.13.3",
    "@unocss/eslint-plugin": "^66.10.0",
    "astro-eslint-parser": "^3.1.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-erasable-syntax-only": "^0.7.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-solid": "^0.17.0",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "eslint-processor-vue-blocks": "^2.0.0",
    "eslint-typegen": "^2.3.1",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-slidev": "^1.0.5",
    "simple-git-hooks": "^2.14.0",
    "svelte": "^5.57.0",
    "svelte-eslint-parser": "^1.8.1",
    "tinyexec": "^1.3.1",
    "tinyglobby": "^0.2.17",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-eslint-parser": "^10.4.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
